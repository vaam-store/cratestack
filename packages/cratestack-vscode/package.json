{
  "name": "cratestack-vscode-plugin",
  "displayName": "CrateStack Schema",
  "description": "VS Code support for CrateStack .cstack schemas",
  "version": "0.12.0",
  "publisher": "cratestack",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1E222E",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cratestack/cratestack.git",
    "directory": "packages/cratestack-vscode"
  },
  "homepage": "https://github.com/cratestack/cratestack/tree/main/packages/cratestack-vscode#readme",
  "bugs": {
    "url": "https://github.com/cratestack/cratestack/issues"
  },
  "keywords": [
    "cratestack",
    "cstack",
    "schema",
    "language-server",
    "rust"
  ],
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:cstack"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "lint": "biome check .",
    "test": "node ./scripts/build.mjs && node --test ./test/*.test.js",
    "vscode:prepublish": "node ./scripts/build.mjs",
    "stage-server": "node ./scripts/stage-server.mjs",
    "package:vsix": "pnpm run stage-server && npx @vscode/vsce package --no-dependencies",
    "publish:vscode-marketplace": "pnpm run stage-server && npx @vscode/vsce publish --no-dependencies",
    "publish:open-vsx": "pnpm run stage-server && npx ovsx publish --packagePath *.vsix",
    "test:smoke": "node --test ./test/*.test.js",
    "test:vscode-smoke": "cargo build -p cratestack-lsp --manifest-path ../../Cargo.toml && node ./test/run-vscode-smoke.js"
  },
  "contributes": {
    "languages": [
      {
        "id": "cstack",
        "aliases": [
          "CrateStack",
          "cstack"
        ],
        "extensions": [
          ".cstack"
        ],
        "icon": {
          "light": "./icons/cstack-light.svg",
          "dark": "./icons/cstack-dark.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cstack",
        "scopeName": "source.cstack",
        "path": "./syntaxes/cstack.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "CrateStack",
      "properties": {
        "cratestack.lsp.path": {
          "type": "string",
          "default": "cratestack-lsp",
          "description": "Path to the cratestack-lsp binary."
        },
        "cratestack.lsp.args": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional arguments passed to the cratestack-lsp binary."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.0",
    "ovsx": "^1.1.1"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  }
}

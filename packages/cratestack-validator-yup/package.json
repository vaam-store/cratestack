{
  "name": "@cratestack/validator-yup",
  "version": "0.12.0",
  "description": "An RpcLink for CrateStack's generated TypeScript RPC client that validates request input against per-op yup schemas.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cratestack/cratestack.git",
    "directory": "packages/cratestack-validator-yup"
  },
  "homepage": "https://cratestack.dev",
  "bugs": "https://github.com/cratestack/cratestack/issues",
  "keywords": [
    "cratestack",
    "cstack",
    "rpc",
    "yup",
    "validation",
    "trpc-links"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check ."
  },
  "dependencies": {
    "@cratestack/ts-types": "0.12.0"
  },
  "peerDependencies": {
    "yup": "^1.4.0"
  },
  "peerDependenciesMeta": {
    "yup": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "yup": "^1.4.0"
  },
  "engines": {
    "node": ">=24"
  }
}

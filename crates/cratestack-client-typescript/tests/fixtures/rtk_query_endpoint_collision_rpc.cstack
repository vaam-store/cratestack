// RPC-transport twin of `rtk_query_endpoint_collision.cstack`, for
// cratestack#906's transport-parity requirement: `templates/src/
// rtk-rest.ts.j2` and `rtk-rpc.ts.j2` are separate hand-written templates
// emitting the same endpoint-map keys behind the same five gates, so a
// REST-only fixture would leave the identical hazard unproven on RPC.
// Identical schema plus `transport rpc`. Original header follows.
//
// Deliberate collision fixture for cratestack#906: model `Post` derives
// the `--rtk` endpoint-map key `listPost` (`crate::rtk::naming`'s scheme —
// the RAW model name, never pluralized, unlike `--swr`'s `model_fn_names`),
// and (query) `procedure list_post` derives the same identifier via
// `to_camel_case("list_post")`.
//
// Deliberately `list_post` (SINGULAR) rather than `list_posts` (plural):
// `cratestack-parser`'s `validate::procedure_handler_collisions` (#784)
// already rejects a procedure literally named `list_posts` because that
// collides with model `Post`'s own generated axum handler
// (`handle_list_posts`, pluralized). `list_post` sidesteps that upstream
// check entirely.

transport rpc

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

auth SessionUser {
  id Int
}

model Post {
  id Int @id
  title String

  @@allow("read", true)
}

procedure list_post(): Post
  @allow(auth() != null)

{
  "name": "tiny-rpc-swr-native-default-client",
  "version": "0.0.0",
  "description": "Generated CrateStack TypeScript client package.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
,
    "./swr": {
      "types": "./dist/swr/index.d.ts",
      "import": "./dist/swr/index.js"
    },
    "./swr/models/*": {
      "types": "./dist/swr/models/*.d.ts",
      "import": "./dist/swr/models/*.js"
    },
    "./swr/procedures": {
      "types": "./dist/swr/procedures.d.ts",
      "import": "./dist/swr/procedures.js"
    },
    "./swr/procedures.hooks": {
      "types": "./dist/swr/procedures.hooks.d.ts",
      "import": "./dist/swr/procedures.hooks.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "swr": "^2.2.0"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "@cratestack/cbor": ">=0.8.15 <0.13.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "swr": "^2.2.0",
    "typescript": "^7.0.2"
  }
}